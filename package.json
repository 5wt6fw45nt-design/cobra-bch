{
  "name": "cobra-near",
  "version": "0.1.0",
  "description": "Cobra on NEAR: talk to Telegram, your clients pay in any crypto on any chain, you receive USDC on NEAR via NEAR Intents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test",
    "build:client": "node scripts/build-client.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/build-client.mjs && wrangler deploy",
    "logs": "wrangler tail",
    "db:migrate": "wrangler d1 migrations apply cobra-near --remote"
  },
  "devDependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@cashlab/cauldron": "^1.0.3",
    "@cashlab/common": "^1.0.5",
    "@concordium/web-sdk": "^12.0.2",
    "@electrum-cash/network": "^4.4.8",
    "@electrum-cash/web-socket": "^4.2.0",
    "@wizardconnect/core": "^0.2.10",
    "@wizardconnect/dapp": "^0.2.7",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.12.0"
  }
}
